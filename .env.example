# EYE Analytics Frontend — Environment Variables
# Copy to .env.local and fill in your values

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost

# Frontend app URL (used in tracker snippet)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public-facing backend URL used in the tracker snippet (what external sites POST to)
NEXT_PUBLIC_TRACKER_URL=https://yourbackend.com

# Laravel Reverb / WebSocket (for real-time)
NEXT_PUBLIC_REVERB_APP_KEY=your-reverb-app-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# Sentry DSN (optional)
NEXT_PUBLIC_SENTRY_DSN=
